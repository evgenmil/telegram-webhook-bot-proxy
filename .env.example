# Скопируйте в `.env` и подставьте значения. Секреты в репозиторий не коммитить.
# Токен Telegram Bot API в этом сервисе НЕ хранится — клиент (например PHP) передаёт его в пути /bot<token>/…

# Обязательные
MAIN_APP_BASE_URL=http://localhost:3000

# ASGI (опционально)
HOST=0.0.0.0
PORT=8000

# Куда Telegram шлёт апдейты на прокси и куда прокси пересылает в основное приложение
# В Git Bash не задавайте путь в export как /foo — MSYS подменит путь; используйте .env или //foo
PROXY_INCOMING_WEBHOOK_PATH=/webhook/telegram
MAIN_APP_INCOMING_PATH=/api/telegram/webhook

# Таймауты исходящих HTTP (секунды). read >= 60–90 для long poll getUpdates (timeout до 50 у Telegram).
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=90

LOG_LEVEL=INFO

# Опционально: Bearer к API основного приложения при пересылке вебхука
# MAIN_APP_BEARER_TOKEN=
